{
  "name": "Rite",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nom du rite (ex: REAA, RER, GLDF)"
    },
    "code": {
      "type": "string",
      "description": "Code court du rite"
    },
    "description": {
      "type": "string",
      "description": "Description du rite"
    },
    "image_url": {
      "type": "string",
      "description": "Image repr\u00e9sentative du rite"
    },
    "order": {
      "type": "number",
      "description": "Ordre d'affichage",
      "default": 0
    }
  },
  "required": [
    "name",
    "code"
  ]
}